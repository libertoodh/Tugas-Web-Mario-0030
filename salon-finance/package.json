{
  "name": "salon-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Neraca Salon — sistem pencatatan transaksi dan laporan keuangan dua cabang salon",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts --max-warnings=0",
    "db:local:start": "tsx scripts/local-db.ts start",
    "db:local:stop": "tsx scripts/local-db.ts stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:local:start && npm run db:migrate && npm run db:seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/newsreader": "5.2.8",
    "@tanstack/react-query": "5.90.20",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "cross-env": "10.1.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jose": "6.2.12",
    "jspdf": "3.0.4",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "0.563.0",
    "pg": "8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.9.6",
    "recharts": "3.4.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.4",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "core-js@3.51.0": true
  }
}
