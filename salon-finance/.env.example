# ── Database ────────────────────────────────────────────────────────────────
# Koneksi admin (migrasi & seed). Jangan dipakai aplikasi.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55433/salon_finance"

# Koneksi aplikasi dengan role terbatas + Row Level Security.
APP_DATABASE_URL="postgresql://salon_app:salon_app_local@127.0.0.1:55433/salon_finance"

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET="dev-secret-ganti-di-produksi-minimal-32-karakter"
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3100,http://127.0.0.1:3100"
SERVE_STATIC=false

# ── Seed demo ───────────────────────────────────────────────────────────────
# Data master selalu di-seed. Transaksi demo ditandai "DEMO" dan bisa dihapus
# dari UI. Set false untuk database produksi.
SEED_DEMO=true
