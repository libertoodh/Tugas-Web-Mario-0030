# ---------------------------------------------------------------------------
# Sistem Peminjaman Ruangan - IDB Bali
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ---------------------------------------------------------------------------

# Database PostgreSQL
# Contoh produksi: postgresql://user:password@localhost:5432/idb_booking?schema=public
# Untuk pengembangan lokal tanpa PostgreSQL terpasang, jalankan:
#   npm run db:local:init   (membuat cluster + database)
#   npm run db:local:start  (menjalankan server di port 55432)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/idb_booking?schema=public"

# URL publik aplikasi (dipakai untuk tautan di email dan konfigurasi cookie).
# Wajib https:// di produksi agar cookie sesi ditandai Secure.
APP_URL="http://localhost:3000"

# (Opsional) Database khusus pengujian otomatis
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/idb_test?schema=public"

# Rahasia penandatanganan sesi (minimal 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"

# Masa berlaku sesi (jam)
SESSION_TTL_HOURS="8"

# Akun demo lokal. Seed akan melewati pembuatan akun ini bila
# SEED_DEMO_ACCOUNTS bukan "true". JANGAN aktifkan di produksi.
SEED_DEMO_ACCOUNTS="true"
DEMO_PEMOHON_EMAIL="mariodharma@gmail.com"
DEMO_PEMOHON_PASSWORD="mariodharma"
DEMO_ADMIN_EMAIL="admin@demo.idb.ac.id"
DEMO_ADMIN_PASSWORD="Admin123!"

# ---------------------------------------------------------------------------
# Email (SMTP). Bila diisi, notifikasi dikirim lewat SMTP.
# Bila kosong, aplikasi memakai driver "log" (email hanya dicatat di server,
# tidak benar-benar terkirim) dan status pengiriman ditandai "SKIPPED".
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="log"           # log | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Sistem Peminjaman Ruangan IDB Bali <no-reply@idb.ac.id>"
# Alamat admin sarana prasarana yang menerima notifikasi pengajuan baru
ADMIN_NOTIFICATION_EMAIL=""

# ---------------------------------------------------------------------------
# Aturan bisnis (DRAF - belum kebijakan resmi kampus, mudah diubah)
# ---------------------------------------------------------------------------
# Minimal H-2 (hari kalender) sebelum tanggal peminjaman
BOOKING_MIN_LEAD_DAYS="2"
# Maksimal pengajuan 30 hari ke depan
BOOKING_MAX_ADVANCE_DAYS="30"
# Durasi maksimum satu peminjaman (jam)
BOOKING_MAX_DURATION_HOURS="8"
# Jam operasional kampus (WITA)
BOOKING_OPEN_HOUR="7"
BOOKING_CLOSE_HOUR="22"

# Integrasi SSO kampus (belum tersedia pada MVP)
# Isi bila adapter SSO sudah diimplementasikan, lihat src/server/auth/sso.ts
SSO_ENABLED="false"
SSO_PROVIDER=""
SSO_ISSUER=""
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
