    "date-fns-tz": "3.2.0",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "react": "19.1.10",
    "react-day-picker": "9.14.0",
    "react-dom": "19.1.10",
    "react-hook-form": "7.60.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
