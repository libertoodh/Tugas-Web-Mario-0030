  "private": true,
  "description": "Sistem Peminjaman Ruangan - Institut Desain dan Bisnis Bali (IDB Bali)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "db:generate": "prisma generate",
