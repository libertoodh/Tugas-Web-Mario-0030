    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local:start": "tsx scripts/local-db.ts start",
    "db:local:stop": "tsx scripts/local-db.ts stop",
    "db:local:init": "tsx scripts/local-db.ts init",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-check.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
